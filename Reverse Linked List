class Solution {
    public ListNode reverseList(ListNode head) {
        ListNode prev = null;
        ListNode present = head;
        ListNode next = null;

        while(present!=null) {
            next = present.next;
            present.next = prev;
            prev = present;
            present = next;
            if(next!=null) {
                next = next.next;
            }
        }
        return prev;
    }
}
